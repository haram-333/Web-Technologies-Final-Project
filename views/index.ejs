<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-KyZXEJxnLeI+e7h9X17fM2EnfL5Ff8V6L/yjTke8qZb0+Yt7ls9Rx2uBktwOSu0J" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Employee Management System</h1>

    <!-- Add Employee Link -->
    <a href="/add">Add New Employee</a>

    <!-- Display Employees -->
    <table border="1">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Salary</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (employees.length> 0) { %>
                <% employees.forEach(employee=> { %>
                    <tr>
                        <td>
                            <%= employee.name %>
                        </td>
                        <td>
                            <%= employee.email %>
                        </td>
                        <td>
                            <%= employee.department %>
                        </td>
                        <td>
                            <%= employee.salary %>
                        </td>
                        <td>
                            <a href="/edit/<%= employee._id %>">Edit</a> |
                            <a href="/delete/<%= employee._id %>" onclick="return confirm('Are you sure?');">Delete</a>
                        </td>
                    </tr>
                    <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5">No employees found</td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</body>

</html>